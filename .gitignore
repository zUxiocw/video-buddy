# Secrets — never committed, never packaged.
extension.pem
extension.crx
.env
.env.*
!.env.example
!.env.local.example

# Server build output and dependencies
server/node_modules/
server/dist/

# Running a tool from the wrong cwd drops a cache here (vitest does it); the
# repo root has no package.json, so anything appearing there is stray.
/node_modules/

# Site build output and dependencies
site/node_modules/
site/dist/
# Staged deploy directory (tools/pack-site.mjs). Build product, not source:
# it duplicates site/ plus the gitignored ZIP, so it would bloat every diff.
site-dist/

# Local release artefacts (regenerate with tools/pack-extension.mjs)
releases/
*.zip
# The repo-snapshot ZIPs under submission/ and design/ used to be tracked, and
# because they were rewritten on every packaging run each rewrite added a fresh
# ~8 MB blob to history — .git grew to 178 MB against 31 MB of actual source.
# They are deleted now, not just untracked: they were only ever repackings of
# directories that are already in the repo, so keeping a stale copy on disk
# invites people to treat it as the source of truth. Shrinking history itself
# needs a filter-repo pass, which rewrites every commit hash — a separate
# decision that has not been taken.
submission/*.zip
design/*.zip

# Editor / OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Project-level Agent Skills are third-party content shipped by the tool, not
# part of this project. `.claude/commands/` (the three slash commands this repo
# actually uses) is tracked; anything under `.claude/skills/` is not.
.claude/skills/

# Ad-hoc scratch files at the repo root
test2.c
output/
previews/

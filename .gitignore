# Secrets — never committed, never packaged.
extension.pem
extension.crx
.env
.env.*
!.env.example
!.env.local.example

# Server build output and dependencies
server/node_modules/
server/dist/

# Running a tool from the wrong cwd drops a cache here (vitest does it); the
# repo root has no package.json, so anything appearing there is stray.
/node_modules/

# Site build output and dependencies
site/node_modules/
site/dist/
# Staged deploy directory (tools/pack-site.mjs). Build product, not source:
# it duplicates site/ plus the gitignored ZIP, so it would bloat every diff.
site-dist/

# Local release artefacts (regenerate with tools/pack-extension.mjs)
releases/
*.zip
# ...except the frozen design archive and the submission packages, which are
# deliberate deliverables, not build products.
!design/*.zip
!submission/*.zip

# Editor / OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Ad-hoc scratch files at the repo root
test2.c
output/
previews/

# Secrets — never committed, never packaged.
extension.pem
extension.crx
.env
.env.*
!.env.example
!.env.local.example

# Server build output and dependencies
server/node_modules/
server/dist/

# Running a tool from the wrong cwd drops a cache here (vitest does it); the
# repo root has no package.json, so anything appearing there is stray.
/node_modules/

# Site build output and dependencies
site/node_modules/
site/dist/
# Staged deploy directory (tools/pack-site.mjs). Build product, not source:
# it duplicates site/ plus the gitignored ZIP, so it would bloat every diff.
site-dist/

# Local release artefacts (regenerate with tools/pack-extension.mjs)
releases/
*.zip
# The build-artefact ZIPs also cover the repo snapshots under submission/ and
# design/. They used to be tracked, and because they were rewritten on every
# packaging run each rewrite added a fresh ~8 MB blob to history — .git grew to
# 178 MB against 31 MB of actual source. Untracked now, and the local copies are
# still on disk. Shrinking history itself needs a filter-branch pass, which is
# a separate decision (it rewrites every commit hash).
submission/*.zip
design/*.zip
# ...except these two, which are deliberate deliverables, not rebuildable
# artefacts, so they stay tracked and stay small.
!submission/shangtou-meowmeow-demo.zip

# Editor / OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Ad-hoc scratch files at the repo root
test2.c
output/
previews/

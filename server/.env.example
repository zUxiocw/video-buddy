# Required: long random string shared with the Android app.
APP_TOKEN=change-me-to-a-long-random-string

PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# mock = no API key needed, deterministic local replies.
# deepseek = real DeepSeek V4.1 Flash via the official OpenAI-compatible API.
MODEL_PROVIDER=mock

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Official model ID for DeepSeek V4.1 Flash is `deepseek-flash`
# (served by DeepSeek-V4.1-Flash-1017). Do NOT use `deepseek-v4.1-flash`.
MODEL_VISION=deepseek-flash
MODEL_CHAT=deepseek-flash
DEEPSEEK_THINKING=disabled
VISION_DETAIL=high

# Timeouts: total analyze budget and upstream budgets.
ANALYZE_TIMEOUT_MS=12000
UPSTREAM_TIMEOUT_MS=10000
CHAT_TIMEOUT_MS=60000

# Trends
TREND_URL=https://60s.lzw.me/?type=douyin
TREND_TTL_MS=2700000

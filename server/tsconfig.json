{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    // The persona / guard / voice-filter rules live in extension/shared/*.js so
    // the server and the extension share one copy. allowJs lets the imports
    // resolve; checkJs stays off because those files are deliberately plain
    // browser scripts (no types, no build step) and are not ours to type.
    "allowJs": true,
    "checkJs": false
  },
  // Listed one by one, not `../extension/shared/*.js`: the other files there
  // (core/emotions/keyboard-guard) are browser-only content scripts the server
  // never imports, and a wildcard would copy them into dist/.
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "../extension/shared/persona.js",
    "../extension/shared/text-core.js",
    "../extension/shared/guards-core.js",
    "../extension/shared/voice-filter.js",
    "../extension/shared/zh-prompt.js"
  ]
}

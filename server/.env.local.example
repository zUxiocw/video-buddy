# Local overrides. This file wins over .env and must never be committed.
# Copy from .env.example and fill in the key, then flip MODEL_PROVIDER here.

MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_VISION=deepseek-flash
MODEL_CHAT=deepseek-flash
DEEPSEEK_THINKING=disabled
VISION_DETAIL=high

ANALYZE_TIMEOUT_MS=12000
UPSTREAM_TIMEOUT_MS=10000
CHAT_TIMEOUT_MS=60000
